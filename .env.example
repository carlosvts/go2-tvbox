# Configuração do Sense. Copie para `.env` (na raiz do repo) e ajuste.
# Trocar de modo = editar SENSE_MODE aqui e reiniciar o serviço:
#   sudo systemctl restart go2-sense
# Valores inválidos ou faltando derrubam o serviço na partida, com a lista
# completa dos problemas no log.

# ─── Modo (obrigatório na TV Box) ─────────────────────────────────────────────
# edge = a TV Box captura, reconhece (wake word + STT) e faz o POST na go2-api.
#        Exige o extra `recognition` instalado e os modelos baixados.
# thin = a TV Box só captura e envia o áudio por TCP; o reconhecimento e o POST
#        rodam no PC (`python -m sense.receiver`). Não exige openWakeWord/Vosk.
SENSE_MODE=edge

# ─── Modo edge (e o receptor no PC) ───────────────────────────────────────────
# Endereço da go2-api. Obrigatório em edge e no receptor; ignorado em thin.
GO2_API_URL=http://192.168.0.10:8000

# ─── Modo thin ────────────────────────────────────────────────────────────────
# IP ou nome do PC que roda o receptor. Obrigatório em thin; ignorado em edge.
RECEIVER_HOST=192.168.0.10
# Porta TCP do receptor. Tem de ser a mesma na TV Box e no PC.
#RECEIVER_PORT=9876

# ─── Áudio (TV Box, nos dois modos) ───────────────────────────────────────────
# Trecho do nome do microfone, como aparece no PyAudio (sem diferenciar caixa).
#MIC_NAME=anker
# Tamanho de cada chunk de áudio, em ms (20 a 40).
#AUDIO_CHUNK_MS=30

# ─── Reconhecimento (onde ele roda: TV Box em edge, PC em thin) ───────────────
# Score mínimo do openWakeWord para "hey jarvis" (0 a 1). Mais alto = menos
# disparos falsos e mais disparos perdidos.
#WAKE_THRESHOLD=0.85
# Confiança mínima do Vosk para aceitar a frase (0 a 1). Vale a menor confiança
# entre as palavras.
#STT_MIN_CONFIDENCE=0.7
# Quanto tempo, em segundos, o Sense espera a frase depois da wake word (1 a 15).
#COMMAND_TIMEOUT_S=2.5
# O mesmo comando repetido dentro desta janela, em segundos, é descartado (0 a 60).
#COOLDOWN_S=2.0
# Como a frase vira comando:
#   livre     = o Vosk transcreve sem gramática e o interpretador
#               (config/interpreter.json) aceita variações da frase.
#   gramatica = só as frases exatas de config/commands.json.
#STT_MODE=livre
# Pasta do modelo Vosk (relativa à raiz do repo, ou absoluta).
#VOSK_MODEL_PATH=models/vosk-model-small-pt-0.3
