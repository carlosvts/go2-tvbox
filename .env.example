# Configuração do Sense. Copie para `.env` (na raiz do repo) e ajuste.
# Depois de editar, reinicie o serviço:
#   sudo systemctl restart go2-sense
# Valores inválidos ou faltando derrubam o serviço na partida, com a lista
# completa dos problemas no log.

# ─── go2-api (obrigatório) ────────────────────────────────────────────────────
GO2_API_URL=http://192.168.0.10:8000

# 1 = antes de cada movimento (andar ou virar), o Sense confere na go2-api se o
# desvio de obstáculo do robô está ligado e manda ligar se não estiver; sem a
# confirmação, o movimento não sai. 0 = movimentos saem sem conferir.
#REQUIRE_OBSTACLE_AVOIDANCE=1

# ─── Fallback: servidor de inferência (opcional) ──────────────────────────────
# Endereço do servidor. Vazio ou ausente = fallback desligado: só a gramática
# local funciona, e o que ela não resolve é descartado.
#SERVER_URL=http://192.168.0.10:9000
# Como esta TV Box se identifica para o servidor. Padrão: o nome da máquina.
#EDGE_ID=tvbox-sala
# Quanto esperar a resposta de uma frase enviada, em segundos (0.5 a 60).
#FALLBACK_TIMEOUT_S=5.0
# Quanto esperar o aviso de cancelamento chegar, em segundos (0.1 a 5). Ele sai
# em paralelo e nunca segura a parada nem o comando local.
#CANCEL_TIMEOUT_S=0.5
# Valores do campo `status` da resposta que contam como "confirmado". Qualquer
# outro vira "não entendi".
#FALLBACK_OK_STATUSES=ok,accepted,queued,executed
# Fala mais longa que isto, em segundos, vai ao fallback mesmo reconhecida (0.5 a 15).
#MAX_LOCAL_UTTERANCE_S=3.0
# 1 = uma palavra de parada vale mesmo com confiança baixa ou no meio de
# palavras desconhecidas (parar por engano é seguro). 0 = a parada duvidosa
# vai ao fallback.
#STOP_FAILSAFE=1

# ─── Áudio ────────────────────────────────────────────────────────────────────
# Trecho do nome do microfone, como aparece no PyAudio (sem diferenciar caixa).
#MIC_NAME=anker
# Tamanho de cada chunk de áudio, em ms (20 a 40).
#AUDIO_CHUNK_MS=30
# Quantos segundos de áudio o buffer circular guarda para o recorte do fallback
# (2 a 60). Tem de ser pelo menos MAX_UTTERANCE_S + 1.
#AUDIO_BUFFER_S=10.0

# ─── Reconhecimento ───────────────────────────────────────────────────────────
# Score mínimo do openWakeWord para "hey jarvis" (0 a 1). Mais alto = menos
# disparos falsos e mais disparos perdidos.
#WAKE_THRESHOLD=0.85
# Confiança mínima do Vosk para aceitar a frase (0 a 1). Vale a menor confiança
# entre as palavras. Abaixo disso a frase vai ao fallback (ou é descartada).
#STT_MIN_CONFIDENCE=0.7
# Quanto tempo, em segundos, o Sense espera a frase depois da wake word (1 a 15).
# Se nesse ponto a pessoa ainda está falando, a escuta continua até a frase
# fechar ou até MAX_UTTERANCE_S.
#COMMAND_TIMEOUT_S=2.5
# Duração máxima de uma escuta, em segundos (1 a 30).
#MAX_UTTERANCE_S=8.0
# O mesmo comando repetido dentro desta janela, em segundos, é descartado (0 a 60).
# Não vale para a parada.
#COOLDOWN_S=2.0
# Pasta do modelo Vosk (relativa à raiz do repo, ou absoluta).
#VOSK_MODEL_PATH=models/vosk-model-small-pt-0.3
