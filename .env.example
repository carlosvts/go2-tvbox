# Configuração do Sense. Copie para `.env` (na raiz do repo) e ajuste.
# Depois de editar, reinicie o serviço:
#   sudo systemctl restart go2-sense
# Valores inválidos ou faltando derrubam o serviço na partida, com a lista
# completa dos problemas no log. Chaves que o Sense não usa mais (as do antigo
# modo edge, como VOSK_MODEL_PATH ou STOP_FAILSAFE) são ignoradas.

# ─── Servidor de inferência (obrigatório) ─────────────────────────────────────
# Recebe o áudio de cada comando, transcreve, interpreta e manda à go2-api.
SERVER_URL=http://192.168.0.10:9000
# Valores do campo `status` da resposta que contam como "confirmado". Os do
# go2-server são enqueued e stopped. Qualquer outro vira "não entendi" (ou
# "comando desligado", se o servidor disser reject_reason=command_disabled).
FALLBACK_OK_STATUSES=enqueued,stopped
# Como esta TV Box se identifica para o servidor. Padrão: o nome da máquina.
#EDGE_ID=tvbox-sala
# Quanto esperar a resposta de um comando enviado, em segundos (0.5 a 60).
#FALLBACK_TIMEOUT_S=5.0
# Quanto esperar o aviso de cancelamento da parada manual, em segundos (0.1 a 5).
# Ele sai em paralelo e nunca segura a parada.
#CANCEL_TIMEOUT_S=0.5

# ─── go2-api (só para a parada manual) ────────────────────────────────────────
# `python -m sense.stop` chama POST /commands/stop aqui, sem passar pelo
# servidor. O laço de voz não usa a go2-api.
GO2_API_URL=http://192.168.0.10:8000

# ─── Áudio ────────────────────────────────────────────────────────────────────
# Trecho do nome do microfone, como aparece no PyAudio (sem diferenciar caixa).
#MIC_NAME=anker
# Tamanho de cada chunk de áudio, em ms (20 a 40).
#AUDIO_CHUNK_MS=30
# Quantos segundos de áudio o buffer circular guarda (2 a 60). Tem de ser pelo
# menos MAX_UTTERANCE_S + 1.
#AUDIO_BUFFER_S=10.0

# ─── Wake word ────────────────────────────────────────────────────────────────
# Modelo do openWakeWord. Outro que não o hey_jarvis precisa ser baixado antes
# (scripts/download_models.py só baixa o hey_jarvis).
#WAKE_WORD=hey_jarvis
# Score mínimo do openWakeWord para "hey jarvis" (0 a 1). Mais alto = menos
# disparos falsos e mais disparos perdidos.
#WAKE_THRESHOLD=0.85
# VAD do Silero na wake word (0 a 1). 0 = desligado. Acima de 0, a wake word só
# vale se houve voz, com pelo menos esta nota, no último segundo: filtra
# disparos por ruído que não é voz. Valor sugerido para ligar: 0.5.
#WAKE_VAD_THRESHOLD=0
# Depois de uma wake word, outra só vale passado este tempo, em segundos (0 a 30).
#WAKE_COOLDOWN_S=2.0
# 1 = toca o beep ao detectar a wake word. 0 = só o log.
#WAKE_SOUND=1
# Com o beep ligado, este começo da escuta (em segundos) não conta como fala,
# para o beep captado pelo microfone não passar por comando (0 a 3).
#BEEP_IGNORE_S=0.9

# ─── Gravação do comando ──────────────────────────────────────────────────────
# Quanto áudio de ANTES da detecção entra no envio, em segundos (0 a 2): a wake
# word é detectada com atraso e o comando pode já ter começado.
#PRE_ROLL_S=0.3
# Silêncio que encerra o comando, em segundos (0.2 a 3).
#VAD_END_SILENCE_S=0.7
# Voz mínima para valer como fala, em segundos; menos que isso é ruído (0.03 a 2).
#VAD_MIN_SPEECH_S=0.2
# Sem fala até este tempo depois da wake word, a escuta é descartada (1 a 30).
#VAD_SPEECH_TIMEOUT_S=5.0
# Um chunk tem voz se o volume passa de VAD_SPEECH_RATIO vezes o ruído de fundo
# e de VAD_MIN_RMS (volume RMS, de 0 a 32767).
#VAD_SPEECH_RATIO=3.0
#VAD_MIN_RMS=150
# Duração máxima do comando, em segundos (1 a 30): a fala é cortada aí.
#MAX_UTTERANCE_S=8.0
# Valor de `reason` no envio.
#UTTERANCE_REASON=wake_word
# Pasta onde salvar cada WAV enviado (relativa ao repo, ou absoluta). Vazio =
# não salva. Atenção ao disco: são ~32 KB por segundo de áudio.
#SAVE_UTTERANCES_DIR=utterances
